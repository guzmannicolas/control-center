generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TargetType {
  domain
  website
  vercel_project
  github_repo
  server
  service
  database
}

enum CheckStatus {
  ok
  warn
  fail
  error
}

enum Severity {
  warn
  fail
}

// Something I own and want to watch.
model Target {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  type      TargetType
  config    Json       @default("{}")
  tags      String[]   @default([])
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  monitors  Monitor[]

  @@map("targets")
}

// One checker run against one target on a schedule.
model Monitor {
  id              String       @id @default(uuid()) @db.Uuid
  targetId        String       @map("target_id") @db.Uuid
  target          Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  checker         String
  intervalSeconds Int          @map("interval_seconds")
  settings        Json         @default("{}")
  enabled         Boolean      @default(true)
  // Copy of the latest result so the dashboard never has to scan the results table.
  lastStatus      CheckStatus? @map("last_status")
  lastCheckedAt   DateTime?    @map("last_checked_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  results         Result[]
  incidents       Incident[]

  @@unique([targetId, checker])
  @@map("monitors")
}

// What happened each time a monitor ran. Grows fast.
model Result {
  id         BigInt      @id @default(autoincrement())
  monitorId  String      @map("monitor_id") @db.Uuid
  monitor    Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  checkedAt  DateTime    @default(now()) @map("checked_at") @db.Timestamptz(3)
  status     CheckStatus
  durationMs Int         @map("duration_ms")
  message    String
  metrics    Json        @default("{}")
  details    Json        @default("{}")

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("results")
}

// A problem with a start and an end: one alert when it breaks, one when it recovers.
model Incident {
  id          String    @id @default(uuid()) @db.Uuid
  monitorId   String    @map("monitor_id") @db.Uuid
  monitor     Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  severity    Severity
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  lastMessage String    @map("last_message")

  @@index([monitorId, openedAt(sort: Desc)])
  @@map("incidents")
}

// Dashboard users. Created from the command line only: there is no sign-up.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]
  learning     LearningProgress[]

  @@map("users")
}

// A logged-in browser. Only a hash of the cookie token is stored, so a database leak exposes no sessions.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?  @map("user_agent")

  @@index([userId])
  @@map("sessions")
}

enum ImprovementStatus {
  idea
  planned
  in_progress
  done
}

enum Priority {
  high
  medium
  low
}

// The backlog: everything worth improving, so nothing found along the way gets lost.
model Improvement {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  details   String            @default("")
  area      String
  priority  Priority          @default(medium)
  status    ImprovementStatus @default(idea)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  doneAt    DateTime?         @map("done_at") @db.Timestamptz(3)

  @@index([status])
  @@map("improvements")
}

// Learning modules a user has passed. The modules themselves live in the code.
model LearningProgress {
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String   @map("module_id")
  score       Int
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  @@id([userId, moduleId])
  @@map("learning_progress")
}


enum LeadStatus {
  discovered
  enriched
  contacted
  replied
  converted
  discarded
}

// B2B Leads for automated sales pipelines (web design, AI automations, ERP, etc.)
model Lead {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  query           String      @default("")
  category        String      @default("")
  city            String      @default("")
  address         String      @default("")
  rating          Float?
  reviewsCount    Int         @default(0) @map("reviews_count")
  phone           String?
  phoneFormatted  String?     @map("phone_formatted")
  email           String?
  website         String?
  instagram       String?
  facebook        String?
  hasWebsite      Boolean     @default(false) @map("has_website")
  status          LeadStatus  @default(discovered)
  suggestedDemo   String?     @map("suggested_demo")
  notes           String      @default("")
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  contactedAt     DateTime?   @map("contacted_at") @db.Timestamptz(3)

  @@index([status])
  @@index([category, city])
  @@index([hasWebsite])
  @@map("leads")
}

// --- Growth & Marketing Engine ---------------------------------------------------------------------

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialPostType {
  POST
  REEL
  CAROUSEL
  STORY
}

enum SocialDraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
}

enum AdPlatform {
  META
  GOOGLE
}

enum AdCampaignStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION
}

model Brand {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  name            String
  website         String
  toneOfVoice     String        @map("tone_of_voice")
  styleDirectives Json          @default("{}") @map("style_directives")
  targetAudience  String?       @map("target_audience")
  whatsappNumber  String?       @map("whatsapp_number")
  telegramChatId  String?       @map("telegram_chat_id")
  dossierMd       String?       @db.Text @map("dossier_md")
  socialStyleMd   String?       @db.Text @map("social_style_md")
  instagramHandle String?       @map("instagram_handle")
  activePlatforms String[]      @default(["INSTAGRAM", "FACEBOOK"]) @map("active_platforms")
  scrapedPosts    Json                @default("[]") @map("scraped_posts")
  integrations    Json                @default("{}") @map("integrations")
  autoPublish     Boolean             @default(false) @map("auto_publish")
  autoReplyChat   Boolean             @default(false) @map("auto_reply_chat")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  drafts          SocialDraft[]
  campaigns       AdCampaign[]
  conversations   BrandConversation[]

  @@map("brands")
}

model BrandConversation {
  id             String   @id @default(uuid()) @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform       String
  customerHandle String   @map("customer_handle")
  customerName   String?  @map("customer_name")
  status         String   @default("ACTIVE")
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  messages       Json     @default("[]") @map("messages")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brand_conversations")
}

model SocialDraft {
  id            String            @id @default(uuid()) @db.Uuid
  brandId       String            @map("brand_id") @db.Uuid
  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform      SocialPlatform
  postType      SocialPostType    @map("post_type")
  caption       String            @db.Text
  mediaUrls     String[]          @default([]) @map("media_urls")
  status        SocialDraftStatus @default(DRAFT)
  scheduledFor  DateTime?         @map("scheduled_for") @db.Timestamptz(3)
  approvalToken String            @unique @map("approval_token")
  feedback      String?           @db.Text
  metrics       Json              @default("{}")
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([brandId, status])
  @@map("social_drafts")
}

model AdCampaign {
  id                 String           @id @default(uuid()) @db.Uuid
  brandId            String           @map("brand_id") @db.Uuid
  brand              Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform           AdPlatform
  externalCampaignId String           @map("external_campaign_id")
  campaignName       String           @map("campaign_name")
  objective          String
  dailyBudget        Float            @map("daily_budget")
  spendToDate        Float            @default(0) @map("spend_to_date")
  cpa                Float            @default(0)
  ctr                Float            @default(0)
  roas               Float            @default(0)
  status             AdCampaignStatus @default(ACTIVE)
  safetyGuardrail    Float            @map("safety_guardrail")
  insights           Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([brandId, status])
  @@map("ad_campaigns")
}
