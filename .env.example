# Copy to .env and fill in. .env is never committed.
HOST_UID=1000
HOST_GID=1000
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://control:change-me@postgres:5432/control
TEST_DATABASE_URL=postgresql://control:change-me@postgres:5432/control_test
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
# The dashboard address: the only site allowed to call the API from a browser.
DASHBOARD_ORIGIN=http://localhost:5173
# false only for local development over plain http
COOKIE_SECURE=false
# Databases to watch: URLs with statistics-only users. Names must start with MONITOR_.
MONITOR_CC_POSTGRES_URL=postgresql://cc_monitor:change-me@postgres:5432/control
MONITOR_CC_REDIS_URL=redis://redis:6379
# Extra wiring for a specific server, if any:
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
